{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "GrowEasy",
  "colors": {
    "primary": "#5927E5",
    "light": "#a78bfa",
    "dark": "#4720b8"
  },
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "family": "Lexend"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "development"
            ]
          },
          {
            "group": "Customization",
            "pages": [
              "essentials/settings",
              "essentials/navigation"
            ]
          },
          {
            "group": "Writing content",
            "pages": [
              "essentials/markdown",
              "essentials/code",
              "essentials/images",
              "essentials/reusable-snippets"
            ]
          },
          {
            "group": "AI tools",
            "pages": [
              "ai-tools/cursor",
              "ai-tools/claude-code",
              "ai-tools/windsurf"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "api-reference/introduction",
              "api-reference/endpoint/start",
              "api-reference/endpoint/status",
              "api-reference/endpoint/credits",
              "api-reference/endpoint/email-find",
              "api-reference/endpoint/email-verify",
              "api-reference/endpoint/email-personal"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "App",
        "href": "https://app.groweasy.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://app.groweasy.io/signin"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/groweasy",
      "linkedin": "https://linkedin.com/company/groweasy"
    }
  }
}
